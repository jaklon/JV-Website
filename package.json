{
  "name": "jv-story", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:hosting": "tsc -b && vite build --base=/jv-story/",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "copy:ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "postinstall": "npm run copy:ffmpeg"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10", "@ffmpeg/ffmpeg": "^0.12.15", "@ffmpeg/util": "^0.12.2",
    "@gsap/react": "^2.1.2", "gsap": "^3.13.0", "lucide-react": "^0.468.0",
    "motion": "^12.23.0", "react": "^19.2.0", "react-dom": "^19.2.0", "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0", "@tailwindcss/vite": "^4.1.0", "@types/node": "^24.0.0",
    "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0", "typescript": "~5.9.3", "vite": "^7.1.0", "vitest": "^3.2.0"
  }
}
